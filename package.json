{
  "name": "omnilex-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.node.json",
    "data:municipalities": "tsx scripts/fetchMunicipalities.ts",
    "data:coats": "tsx scripts/downloadCantonCoats.ts",
    "data:municipality-coats:zrh": "tsx scripts/downloadMunicipalityCoats.ts --canton Q11943",
    "data:gemeindeordnung": "tsx scripts/downloadGemeindeordnung.ts",
    "data:gemeindeordnung-articles": "tsx scripts/buildGemeindeordnungArticles.ts",
    "data:gemeindeordnung:md": "tsx scripts/convertPdfToMd.ts",
    "data:refresh": "npm run data:coats && npm run data:municipality-coats:zrh && npm run data:municipalities"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.14",
    "docling-sdk": "^1.3.6",
    "dotenv": "^16.4.5",
    "openai": "^6.16.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.1"
  }
}
